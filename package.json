{
  "name": "grabit",
  "version": "0.1.0",
  "private": true,
  "description": "LINE 群組檔案自動歸檔與管理系統（Cloudflare Workers + D1 + Google Drive）",
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "build:demo": "vite build --config web/vite.demo.config.ts && node web/demo/inline.mjs",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:cloudflare": "wrangler d1 migrations apply grabit --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply grabit --local",
    "db:migrate:remote": "wrangler d1 migrations apply grabit --remote",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:web && node test/e2e/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "fflate": "^0.8.3",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "postal-mime": "^2.7.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.17.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "GrabIt 的資料庫（檔案清單、規則、成員）。保持預設名稱 `grabit` 就好，會自動建在**你自己的** Cloudflare 帳號。"
      },
      "FILE_QUEUE": {
        "description": "背景處理檔案用的佇列。保持預設名稱就好，免費方案也可以用。"
      }
    }
  }
}
