# 本機開發用範本：複製成 .dev.vars 供本機 `wrangler dev` 使用；正式環境的密鑰請在 Cloudflare 後台 Variables and Secrets 設定
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 雲端空間（用哪個就設定哪個）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# AI 文件判讀：預設用 Workers AI（wrangler.toml 的 [ai]，本機開發需要先 npx wrangler login）
# 選用：Gemini 免費 API、Claude（付費）
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# 可以登入的管理員 Google 帳號（逗號分隔）
ADMIN_EMAILS=
# 本機開發時略過登入（只在 localhost 有效）
DEV_NO_AUTH=true
